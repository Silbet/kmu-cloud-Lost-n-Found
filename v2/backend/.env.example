DATABASE_URL="postgresql://lost_found_user:lost_found_password@localhost:5432/lost_found?schema=public"
PORT=3000
JWT_SECRET="dev-secret-change-me"
WEB_DIR="./public"

# AWS common settings
AWS_REGION="us-east-1"
AWS_RESOURCE_PREFIX="pj-kmucloud-6-v2"

# RDS PostgreSQL example for deployed environments.
# DATABASE_URL="postgresql://USER:PASSWORD@pj-kmucloud-6-v2-rds.xxxxxxxxxxxx.us-east-1.rds.amazonaws.com:5432/lost_found?schema=public"

# S3 image storage
S3_IMAGE_BUCKET="pj-kmucloud-6-v2-images"
S3_IMAGE_PUBLIC_BASE_URL=""
PRESIGNED_UPLOAD_EXPIRES_SECONDS="300"

# SQS async matching
SQS_MATCHING_QUEUE_URL=""
MATCHING_MODE="inline"

# SNS notification publishing
SNS_NOTIFICATION_TOPIC_ARN=""
NOTIFICATION_PUBLISH_MODE="in-app"

# Scheduled jobs
SCHEDULED_JOB_SECRET=""
